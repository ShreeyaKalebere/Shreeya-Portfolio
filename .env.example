# Resend Transactional Email API Key
# Obtain for free at: https://resend.com/
RESEND_API_KEY=re_your_api_key_here

# The destination email address where contact inquiries should be delivered
# Example: shreeyakalebere@gmail.com
CONTACT_RECEIVER_EMAIL=your_email@example.com

# The verified sender email address.
# For testing with Resend before verifying a custom domain, use:
# onboarding@resend.dev
EMAIL_FROM_ADDRESS=Portfolio Contact <onboarding@resend.dev>

# Optional: Enable auto-reply confirmation to the visitor (true / false)
ENABLE_AUTO_REPLY=true
